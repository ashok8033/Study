<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE Plugin PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<Plugin certificationLevel="None"
        displayName="Task Status Dashboard"
        minSystemVersion="8.0"
        minUpgradableVersion="1.0.0"
        name="TaskStatusDashboard"
        rightRequired="ViewTaskStatusDashboard"
        version="1.0.4">
  <Attributes>
    <Map>
      <entry key="settings">
        <value>
          <List>
            <Setting dataType="string" name="reportRecipients" label="Report recipients"
                     helpText="Comma separated email addresses the Email Report button sends to."
                     defaultValue="ashokhearts@gmail.com"/>
          </List>
        </value>
      </entry>
      <entry key="fullPage">
        <value>
          <FullPage title="Scheduled Task Status"/>
        </value>
      </entry>
      <entry key="restResources">
        <value>
          <List>
            <String>com.plugin.taskstatus.rest.TaskStatusResource</String>
          </List>
        </value>
      </entry>
    </Map>
  </Attributes>
</Plugin>
