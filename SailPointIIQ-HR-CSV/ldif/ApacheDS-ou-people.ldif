# Creates the container for IIQ-provisioned users in ApacheDS.
# ApacheDS ships with the partition dc=example,dc=com.
# Import with Apache Directory Studio: right-click dc=example,dc=com > Import > LDIF Import
# or:  ldapadd -H ldap://localhost:10389 -D "uid=admin,ou=system" -w secret -f ApacheDS-ou-people.ldif

dn: ou=people,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: people
description: Users provisioned by SailPoint IdentityIQ
