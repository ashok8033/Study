# Creates the three role groups in ApacheDS.
#
# Users are created by SailPoint in   ou=users,ou=system
# Groups live in                       ou=groups,ou=system
# Both OUs exist in a default ApacheDS install, so only the groups are added here.
#
# Import with Apache Directory Studio: right-click ou=groups,ou=system > Import > LDIF Import
# or:  ldapadd -H ldap://localhost:10389 -D "uid=admin,ou=system" -w secret -f ApacheDS-groups.ldif
#
# groupOfUniqueNames needs at least one member, so each group starts with the
# admin entry as a placeholder member.

dn: cn=AllEmployees,ou=groups,ou=system
objectClass: top
objectClass: groupOfUniqueNames
cn: AllEmployees
description: Every Active identity (Birthright - All Active Users)
uniqueMember: uid=admin,ou=system

dn: cn=Contractors,ou=groups,ou=system
objectClass: top
objectClass: groupOfUniqueNames
cn: Contractors
description: Active contractors (Birthright - Contractors)
uniqueMember: uid=admin,ou=system

dn: cn=Managers,ou=groups,ou=system
objectClass: top
objectClass: groupOfUniqueNames
cn: Managers
description: Active managers, isManager = Y (Birthright - Managers)
uniqueMember: uid=admin,ou=system
