# Office365Access group for the requestable role "Office365 Access".
# Requires ou=groups,dc=example,dc=com to exist (see ApacheDS-ou-people-and-groups.ldif).
#
# Import with Apache Directory Studio: right-click ou=groups,dc=example,dc=com > Import > LDIF Import
# or:  ldapadd -H ldap://localhost:10389 -D "uid=admin,ou=system" -w secret -f ApacheDS-group-Office365Access.ldif
#
# groupOfUniqueNames needs at least one member, so it starts with the admin
# entry as a placeholder member.

dn: cn=Office365Access,ou=groups,dc=example,dc=com
objectClass: top
objectClass: groupOfUniqueNames
cn: Office365Access
description: Office 365 access (requestable role "Office365 Access")
uniqueMember: uid=admin,ou=system
