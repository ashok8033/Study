<?xml version='1.0' encoding='UTF-8'?>
<!--
  REFERENCE SNIPPET - DO NOT IMPORT AS-IS.

  Identity Mappings for the HR Authoritative CSV application.
  Either:
    (a) create these in the UI: Global Settings > Identity Mappings, or
    (b) export your current ObjectConfig "Identity", add/merge the
        <ObjectAttribute> elements below into it, and re-import.
  Importing only this snippet would overwrite the whole Identity ObjectConfig.

  firstname, lastname, manager, inactive are standard attributes - only add
  the <AttributeSource> to the existing definition.
  The others are new (non-searchable) extended attributes. Add
  extendedNumber="n" if you need them searchable.
-->
<ObjectConfig name="Identity">

  <ObjectAttribute displayName="Employee Number" editMode="ReadOnly" name="employeeNumber" type="string">
    <AttributeSource name="employeeNumber">
      <ApplicationRef><Reference class="sailpoint.object.Application" name="HR Authoritative CSV"/></ApplicationRef>
    </AttributeSource>
  </ObjectAttribute>

  <ObjectAttribute displayName="att_first_name" editMode="ReadOnly" name="firstname" standard="true" type="string">
    <AttributeSource name="firstName">
      <ApplicationRef><Reference class="sailpoint.object.Application" name="HR Authoritative CSV"/></ApplicationRef>
    </AttributeSource>
  </ObjectAttribute>

  <ObjectAttribute displayName="att_last_name" editMode="ReadOnly" name="lastname" standard="true" type="string">
    <AttributeSource name="lastName">
      <ApplicationRef><Reference class="sailpoint.object.Application" name="HR Authoritative CSV"/></ApplicationRef>
    </AttributeSource>
  </ObjectAttribute>

  <!-- managerId value is resolved to an Identity by "HR CSV - Manager Correlation" -->
  <ObjectAttribute displayName="att_manager" editMode="ReadOnly" name="manager" standard="true" type="sailpoint.object.Identity">
    <AttributeSource name="managerId">
      <ApplicationRef><Reference class="sailpoint.object.Application" name="HR Authoritative CSV"/></ApplicationRef>
    </AttributeSource>
  </ObjectAttribute>

  <ObjectAttribute displayName="att_inactive" editMode="ReadOnly" name="inactive" standard="true" type="boolean">
    <AttributeSource name="inactive">
      <ApplicationRef><Reference class="sailpoint.object.Application" name="HR Authoritative CSV"/></ApplicationRef>
    </AttributeSource>
  </ObjectAttribute>

  <ObjectAttribute displayName="Start Date" editMode="ReadOnly" name="startDate" type="string">
    <AttributeSource name="startDate">
      <ApplicationRef><Reference class="sailpoint.object.Application" name="HR Authoritative CSV"/></ApplicationRef>
    </AttributeSource>
  </ObjectAttribute>

  <ObjectAttribute displayName="End Date" editMode="ReadOnly" name="endDate" type="string">
    <AttributeSource name="endDate">
      <ApplicationRef><Reference class="sailpoint.object.Application" name="HR Authoritative CSV"/></ApplicationRef>
    </AttributeSource>
  </ObjectAttribute>

  <ObjectAttribute displayName="Job Description" editMode="ReadOnly" name="jobDescription" type="string">
    <AttributeSource name="jobDescription">
      <ApplicationRef><Reference class="sailpoint.object.Application" name="HR Authoritative CSV"/></ApplicationRef>
    </AttributeSource>
  </ObjectAttribute>

  <ObjectAttribute displayName="Country" editMode="ReadOnly" name="country" type="string">
    <AttributeSource name="country">
      <ApplicationRef><Reference class="sailpoint.object.Application" name="HR Authoritative CSV"/></ApplicationRef>
    </AttributeSource>
  </ObjectAttribute>

  <ObjectAttribute displayName="Employee Type" editMode="ReadOnly" name="employeeType" type="string">
    <AttributeSource name="employeeType">
      <ApplicationRef><Reference class="sailpoint.object.Application" name="HR Authoritative CSV"/></ApplicationRef>
    </AttributeSource>
  </ObjectAttribute>

  <ObjectAttribute displayName="HR Status" editMode="ReadOnly" name="hrStatus" type="string">
    <AttributeSource name="status">
      <ApplicationRef><Reference class="sailpoint.object.Application" name="HR Authoritative CSV"/></ApplicationRef>
    </AttributeSource>
  </ObjectAttribute>

</ObjectConfig>
