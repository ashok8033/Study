<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE sailpoint PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!--
  Quick link "Emergency Identity Disable / Enable" and who may use it.

  Shown only to identities with the SystemAdministrator capability or the
  EmergencyIdentityAdministrator capability below (directly or through a
  workgroup), decided by the rule "Emergency Identity - Admin Selector".
  The workflow checks the same capabilities again before it changes anything.
  Import the rule before this file.
-->
<sailpoint>
  <SPRight name="EmergencyIdentityDisableEnable" displayName="Emergency Identity Disable / Enable"/>

  <Capability name="EmergencyIdentityAdministrator" displayName="Emergency Identity Administrator">
    <Description>May disable and re-enable identities with the Emergency Identity Disable / Enable quick link.</Description>
    <RightRefs>
      <Reference class="sailpoint.object.SPRight" name="EmergencyIdentityDisableEnable"/>
    </RightRefs>
  </Capability>

  <DynamicScope name="Emergency Identity Administrators">
    <Selector>
      <IdentitySelector>
        <RuleRef>
          <Reference class="sailpoint.object.Rule" name="Emergency Identity - Admin Selector"/>
        </RuleRef>
      </IdentitySelector>
    </Selector>
  </DynamicScope>

  <QuickLink action="workflow" category="Custom" messageKey="Emergency Identity Disable / Enable"
             name="Emergency Identity Disable / Enable" ordering="20">
    <Attributes>
      <Map>
        <entry key="workflowName" value="Emergency Identity Status Management Workflow"/>
      </Map>
    </Attributes>
    <QuickLinkOptions allowSelf="true">
      <DynamicScopeRef>
        <Reference class="sailpoint.object.DynamicScope" name="Emergency Identity Administrators"/>
      </DynamicScopeRef>
    </QuickLinkOptions>
  </QuickLink>
</sailpoint>
