<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE TaskDefinition PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<TaskDefinition name="HR Authoritative CSV - Account Aggregation"
                resultAction="Rename"
                subType="task_item_type_acct_aggregation"
                type="AccountAggregation">
  <Attributes>
    <Map>
      <entry key="applications" value="HR Authoritative CSV"/>
      <entry key="checkDeleted" value="true"/>
      <entry key="checkHistory" value="false"/>
      <entry key="correlateOnly" value="false"/>
      <entry key="noOptimizeReaggregation" value="true"/>
      <entry key="promoteManagedAttributes" value="false"/>
      <entry key="refreshManagerStatus" value="true"/>
      <entry key="refreshScorecard" value="false"/>
    </Map>
  </Attributes>
  <Description>Aggregates the pipe delimited HR CSV file and creates/updates identities.</Description>
  <Owner>
    <Reference class="sailpoint.object.Identity" name="spadmin"/>
  </Owner>
  <Parent>
    <Reference class="sailpoint.object.TaskDefinition" name="Account Aggregation"/>
  </Parent>
</TaskDefinition>
