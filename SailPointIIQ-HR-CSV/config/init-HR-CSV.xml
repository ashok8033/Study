<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE sailpoint PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!--
  Imports everything in dependency order (rules before the application).
  From IIQ console:   import /path/to/SailPointIIQ-HR-CSV/config/init-HR-CSV.xml
-->
<sailpoint>
  <ImportAction name="include" value="Rule/Rule-HR_CSV-Customization.xml"/>
  <ImportAction name="include" value="Rule/Rule-HR_CSV-Correlation.xml"/>
  <ImportAction name="include" value="Rule/Rule-HR_CSV-ManagerCorrelation.xml"/>
  <ImportAction name="include" value="Rule/Rule-HR_CSV-IdentityCreation.xml"/>
  <ImportAction name="include" value="Rule/Rule-HR_Lifecycle-StatusAttribute.xml"/>
  <ImportAction name="include" value="Application/Application-HR_Authoritative_CSV.xml"/>
  <ImportAction name="include" value="TaskDefinition/TaskDefinition-HR_CSV-Aggregation.xml"/>
  <ImportAction name="include" value="EmailTemplate/EmailTemplate-HR_Lifecycle-StatusChange.xml"/>
  <ImportAction name="include" value="Workflow/Workflow-HR_Lifecycle-StatusChange.xml"/>
  <ImportAction name="include" value="IdentityTrigger/IdentityTrigger-HR_Lifecycle-StatusChange.xml"/>
  <ImportAction name="include" value="TaskDefinition/TaskDefinition-HR_Lifecycle-DailyRefresh.xml"/>
  <!-- Imported here, but must be RUN once afterwards: rule "HR CSV - Setup Identity Mappings" -->
  <ImportAction name="include" value="Rule/Rule-HR_CSV-SetupIdentityMappings.xml"/>
  <!-- Run once afterwards: rule "HR CSV - Show Attributes On Identity Page" -->
  <ImportAction name="include" value="Rule/Rule-HR_CSV-ShowOnIdentityPage.xml"/>
  <!-- Read-only troubleshooting: rule "HR CSV - Diagnose" -->
  <ImportAction name="include" value="Rule/Rule-HR_CSV-Diagnose.xml"/>
  <!-- Troubleshooting: rule "HR Lifecycle - Send Test Email" -->
  <ImportAction name="include" value="Rule/Rule-HR_Lifecycle-SendTestEmail.xml"/>
</sailpoint>
